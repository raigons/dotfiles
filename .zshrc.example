# Environment variables
export DOTFILES="${HOME}/dotfiles"
export SYSTEM="${DOTFILES}/system"
export EDITOR='vim'

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

# PATH configuration - consolidated for performance
export PATH="$HOME/bin:/usr/local/bin:/opt/homebrew/bin:${ASDF_DATA_DIR:-$HOME/.asdf}/shims:/Applications/Visual Studio Code.app/Contents/Resources/app/bin:$PATH"

# Oh My Zsh
export ZSH="${HOME}/.oh-my-zsh"

# Spaceship theme
ZSH_THEME="spaceship"
SPACESHIP_USER_SHOW="true"
SPACESHIP_USER_COLOR="blue"
SPACESHIP_DIR_SHOW="true"
SPACESHIP_DIR_TRUNC="0"
SPACESHIP_DIR_TRUNC_REPO="false"
SPACESHIP_DIR_COLOR="cyan"
SPACESHIP_GIT_SHOW="true"
SPACESHIP_GIT_PREFIX="git:"
SPACESHIP_GIT_BRANCH_SHOW="true"
SPACESHIP_GIT_BRANCH_PREFIX="("
SPACESHIP_GIT_BRANCH_SUFFIX=")"
SPACESHIP_GIT_BRANCH_COLOR="red"

# SPACESHIP_GIT_STATUS_SHOW="true"
# SPACESHIP_BATTERY_SHOW="true"

SPACESHIP_TIME_SHOW="true"
SPACESHIP_PROMPT_ORDER=(
  time
  user
  dir
  git
  exec_time
)
SPACESHIP_RPROMPT_ORDER=(
  node
)

# Load fast-syntax-highlighting if available
[ -f "$ZSH/plugins/fsh/fast-syntax-highlighting.plugin.zsh" ] && source "$ZSH/plugins/fsh/fast-syntax-highlighting.plugin.zsh"

# Plugins
plugins=(git zsh-nvm zsh-completions)
fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src
autoload -U compinit && compinit

source "$ZSH/oh-my-zsh.sh"

# Aliases
[ -f "$SYSTEM/.alias" ] && source "$SYSTEM/.alias"

# Load asdf golang plugin
[ -f "${ASDF_DATA_DIR:-$HOME/.asdf}/plugins/golang/set-env.zsh" ] && . "${ASDF_DATA_DIR:-$HOME/.asdf}/plugins/golang/set-env.zsh"

# Google Cloud SDK (uncomment if installed)
# if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi
# if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

export PATH="$HOME/.local/bin:$PATH"

# Deduplicate PATH to remove redundant entries
typeset -U path
path=($path)
